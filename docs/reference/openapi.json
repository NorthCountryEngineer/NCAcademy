  "components": {
    "schemas": {
      "ApprovedText": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Id"
          },
          "text": {
            "type": "string",
            "maxLength": 1500,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "title": "ApprovedText"
      },
      "AssignmentInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "module": {
            "type": "string",
            "maxLength": 200,
            "title": "Module",
            "default": "General"
          },
          "instructions": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Instructions"
          },
          "tutor_policy": {
            "$ref": "#/components/schemas/TutorPolicy"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "instructions"
        ],
        "title": "AssignmentInput"
      },
      "ConnectionInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "protocol": {
            "type": "string",
            "const": "openai_compatible",
            "title": "Protocol",
            "default": "openai_compatible"
          },
