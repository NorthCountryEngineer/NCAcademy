{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NCAcademy operational audit metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_sequence",
    "audit_sha256",
    "previous_audit_sha256",
    "event_type",
    "occurred_at",
    "tenant_ref",
    "event_ref"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "audit_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "audit_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previous_audit_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]{0,59}$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 80
    },
    "tenant_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "event_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "session_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "school_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "course_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "teacher_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "teacher_profile_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lesson_turn_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "homework_session_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "homework_message_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "operation_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "admitted",
        "pending",
        "sent",
        "completed",
        "released",
        "refused",
        "blocked",
        "failed",
        "withheld",
        "uncertain",
        "not_sent",
        "clarification",
        "ready",
        "unavailable",
        "cancelled",
        "approved",
        "revoked"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "triage",
        "tutor",
        "safety"
      ]
    },
    "usage": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "cached_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        }
      }
    },
    "snapshot_sha256": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "model_snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "integration_snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "teacher_snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "corpus_snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "routing_snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "configuration_snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "grounding_snapshot": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "model": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "triage": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
