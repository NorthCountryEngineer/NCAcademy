{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PrivateTenantConditionalAppend",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectRetention", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::ncacademy-audit/ncacademy/REPLACE-TENANT-SHA256/*"]
    },
    {
      "Sid": "NeverDeleteOrMutateRetention",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion", "s3:BypassGovernanceRetention", "s3:PutObjectRetention", "s3:PutObjectLegalHold", "s3:PutBucketPolicy", "s3:PutBucketObjectLockConfiguration"],
      "Resource": ["arn:aws:s3:::ncacademy-audit", "arn:aws:s3:::ncacademy-audit/*"]
    }
  ]
}
