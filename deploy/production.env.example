# Reference for a trusted Core-managed runtime. Values are supplied by Core/ECS.
# This file contains no credentials and is not an executable deployment recipe.
AUTH_MODE=core
APP_URL=https://ncacademy.app
DEMO_SEED=false
ALLOW_LIVE_MODELS=false
ALLOW_AGENT_TEACHERS=false
CORE_ISSUER=https://core.nnytech.ai
CORE_BROWSER_CLIENT_ID=CORE_REGISTERED_PUBLIC_CLIENT_ID
CORE_ORGANIZATION_ID=CORE_REGISTERED_ORGANIZATION_ID
CORE_SERVICE_ID=CORE_REGISTERED_SERVICE_ID
CORE_DEPLOYMENT_ID=CORE_REGISTERED_DEPLOYMENT_ID
CORE_ENVIRONMENT=production
DB_HOST=PRIVATE_RDS_ENDPOINT
DB_PORT=5432
DB_NAME=academy
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/ssl/certs/rds-global-bundle.pem
# ECS secrets inject SESSION_SECRET, DB_USERNAME, DB_PASSWORD,
# CORE_RESOURCE_CREDENTIALS_JSON. Never add their values to this file.
# The separate migration task also receives ACADEMY_RUNTIME_DB_USERNAME and
# ACADEMY_RUNTIME_DB_PASSWORD to provision the restricted API role.

# Only after separate Core and school approvals, enable agent teachers and inject
# CORE_WORKLOAD_TOKEN from the backend runtime secret key core_workload_token.
# CORE_WORKLOAD_TOKEN_FILE is an alternative private file input; never supply both.
# This is a receiving-service workload credential, not the OAuth client secret.
