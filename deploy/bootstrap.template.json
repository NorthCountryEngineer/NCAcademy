{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "NCAcademy release bootstrap: immutable API registry, external vault bootstrap and independently retained audit checkpoints. Application runtime has no access to checkpoint storage or signing keys.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    },
    "com.aws.cloudformation.Context": {
      "ref": [
        {
          "at": "../docs/deployment.md",
          "has": "release procedure, runtime isolation and manual checkpoint acceptance"
        }
      ]
    }
  },
  "Parameters": {
    "RepositoryName": {
      "Type": "String",
      "Default": "nce-family-academy-api",
      "AllowedPattern": "[a-z0-9][a-z0-9-]{2,100}"
    },
    "RuntimeSecretName": {
      "Type": "String",
      "Default": "nce-family-academy-runtime",
      "AllowedPattern": "[a-zA-Z0-9/_+=.@-]{1,100}"
    }
  },
  "Resources": {
    "ApiRepository": {
      "Type": "AWS::ECR::Repository",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Publish the reviewed immutable API used by runtime and migrations.",
          "must": [
            "Never replace existing image bytes under an existing tag."
          ]
        }
      },
      "Properties": {
        "RepositoryName": {
          "Ref": "RepositoryName"
        },
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "NCAcademy"
          }
        ]
      }
    },
    "RuntimeSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Keep session/vault encryption bootstrap independent of images and data restore.",
          "must": [
            "Retain the same secret across application upgrades and matching restores.",
            "Never export secret material in stack outputs or frontend."
          ]
        }
      },
      "Properties": {
        "Name": {
          "Ref": "RuntimeSecretName"
        },
        "Description": "NCAcademy session and encrypted-vault bootstrap",
        "GenerateSecretString": {
          "SecretStringTemplate": "{}",
          "GenerateStringKey": "session_secret",
          "PasswordLength": 64,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "NCAcademy"
          }
        ]
      }
    },
    "AuditBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Independent checkpoint/export retention outside application and database credentials.",
          "must": [
            "Application runtime has no AWS task role or bucket permissions.",
            "Initial 30-day governance retention is for operator checkpoints; approve student retention before admission."
          ]
        }
      },
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "ObjectLockEnabled": true,
        "ObjectLockConfiguration": {
          "ObjectLockEnabled": "Enabled",
          "Rule": {
            "DefaultRetention": {
              "Mode": "GOVERNANCE",
              "Days": 30
            }
          }
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "NCAcademy"
          }
        ]
      }
    },
    "AuditBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Reject plaintext checkpoint transport.",
          "must": [
            "Preserve HTTPS-only access and private ownership."
          ]
        }
      },
      "Properties": {
        "Bucket": {
          "Ref": "AuditBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyInsecureTransport",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "AuditBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${AuditBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "AuditSigningKey": {
      "Type": "AWS::KMS::Key",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Sign tenant audit heads outside the application/database trust boundary.",
          "must": [
            "No key or signing permission is granted to the application runtime.",
            "Retain key and public verification material for checkpoint verification."
          ]
        }
      },
      "Properties": {
        "Description": "NCAcademy independently signed audit checkpoints",
        "KeySpec": "ECC_NIST_P256",
        "KeyUsage": "SIGN_VERIFY",
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "AccountKeyAdministration",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root"
                }
              },
              "Action": "kms:*",
              "Resource": "*"
            }
          ]
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "NCAcademy"
          }
        ]
      }
    }
  },
  "Outputs": {
    "ApiRepositoryUri": {
      "Description": "Immutable API image repository",
      "Value": {
        "Fn::GetAtt": [
          "ApiRepository",
          "RepositoryUri"
        ]
      }
    },
    "RuntimeSecretArn": {
      "Description": "Backend-only external session/vault bootstrap secret ARN",
      "Value": {
        "Ref": "RuntimeSecret"
      }
    },
    "AuditBucketName": {
      "Description": "Private Object Lock checkpoint/export bucket",
      "Value": {
        "Ref": "AuditBucket"
      }
    },
    "AuditSigningKeyArn": {
      "Description": "Independent audit checkpoint signing key",
      "Value": {
        "Fn::GetAtt": [
          "AuditSigningKey",
          "Arn"
        ]
      }
    }
  }
}
