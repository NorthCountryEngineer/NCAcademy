# Local demonstration only. Generate private values with scripts/setup_local.py.
APP_URL=http://localhost:8090
APP_PORT=8090
AUTH_MODE=local
DEMO_SEED=true
POSTGRES_PASSWORD=GENERATE_WITH_SETUP_LOCAL
SESSION_SECRET=GENERATE_WITH_SETUP_LOCAL
# Synthetic local family previews may use the demo-only derived PII key.
# Production requires a separate random PII_ENCRYPTION_KEY or private _FILE.
# Never put a real PII key or real student data into this demo.
# Compose deliberately disables live providers; do not add API keys here.

# Core agent credentials are never accepted in local demonstration mode.
ALLOW_AGENT_TEACHERS=false
# Live Core Chat is independently disabled in local demonstration mode.
CORE_CHAT_ENABLED=false
# Students use a separate approved Google web OAuth client in production only.
GOOGLE_CLASSROOM_ENABLED=false
