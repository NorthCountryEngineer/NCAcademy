# Local demonstration only. Generate private values with scripts/setup_local.py.
APP_URL=http://localhost:8090
APP_PORT=8090
AUTH_MODE=local
DEMO_SEED=true
POSTGRES_PASSWORD=GENERATE_WITH_SETUP_LOCAL
SESSION_SECRET=GENERATE_WITH_SETUP_LOCAL
# Compose deliberately disables live providers; do not add API keys here.

# Core agent credentials are never accepted in local demonstration mode.
ALLOW_AGENT_TEACHERS=false
