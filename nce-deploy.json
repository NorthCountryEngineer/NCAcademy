{
  "schema": 1,
  "archetype": "amplify-academy-fargate",
  "frontend": {
    "directory": "apps/web",
    "output": "dist"
  },
  "backend": {
    "image": "REQUIRES_IMMUTABLE_PRIVATE_ECR_DIGEST"
  },
  "identity": {
    "callback_path": "/api/auth/core/callback",
    "permissions": [
      {
        "codename": "academy-use",
        "name": "Use NCAcademy"
      },
      {
        "codename": "academy-school",
        "name": "Manage assigned schools and their resources"
      },
      {
        "codename": "academy-teach",
        "name": "Teach and manage assigned courses"
      },
      {
        "codename": "academy-audit",
        "name": "Review assigned student sessions"
      }
    ]
  }
}
