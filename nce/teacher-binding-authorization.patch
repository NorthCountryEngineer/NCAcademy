--- /dev/null
+++ b/platform_services/tests/test_agent_binding_authorization.py
@@ -0,0 +1,107 @@
+"""Own-consumer live agent authorization without credential exchange."""
+from datetime import timedelta
+from django.test import TestCase
+from django.utils import timezone
+from identity.models import AuditEvent, PermissionTag, ProtectedResource, ServicePermission
+from platform_services.models import AgentCredential, AgentDefinition, AgentTask, MarketplacePackage
+from platform_services.services import install_package, issue_workload_credential
+from platform_services.tests.test_agent_accounts import AgentAccountTests
+
+
+class AgentBindingAuthorizationTests(TestCase):
+    @classmethod
+    def setUpTestData(cls):
+        AgentAccountTests.setUpTestData.__func__(cls)
+        cls.resource = ProtectedResource.objects.create(service=cls.installation.service,
+            resource_type='academy-school', external_id='approved-school', name='Approved school')
+        cls.task.resources = {**cls.task.resources, 'service_resources': [str(cls.resource.pk)]}
+        cls.task.save()
+
+    api = AgentAccountTests.api
+
+    def authorize(self, **changes):
+        values = {'binding_id': str(self.binding.pk), 'environment': 'development', 'task_id': None,
+            'permission': 'test-execute', 'resource_type': 'academy-school', 'resource_id': 'approved-school'}
+        caller = changes.pop('caller', None)
+        values.update(changes)
+        return self.api('/agent-bindings/authorize/', values, caller)
+
+    def test_authorizes_exact_own_consumer_context_without_issuing_credentials(self):
+        count = AgentCredential.objects.count()
+        claims = self.authorize().json()
+        self.assertTrue(claims['active'])
+        self.assertEqual(claims['aud'], self.installation.service.audience)
+        self.assertEqual(claims['binding_id'], str(self.binding.pk))
+        self.assertEqual(claims['agent_id'], str(self.agent.account_id))
+        self.assertEqual(claims['consumer_service_id'], str(self.installation.service_id))
+        self.assertEqual(claims['resource_id'], 'approved-school')
+        self.assertEqual(claims['permissions'], ['test-execute'])
+        self.assertLessEqual(claims['exp'] - claims['iat'], 60)
+        self.assertGreater(claims['exp'], timezone.now().timestamp())
+        self.assertEqual(AgentCredential.objects.count(), count)
+        self.assertNotIn('access_token', claims)
+        event = AuditEvent.objects.filter(action='agent.binding_authorized', outcome='allowed').last()
+        self.assertEqual(event.principal_kind, 'agent')
+        self.assertEqual(event.principal_id, self.agent.account_id)
+        self.assertIn('no-store', self.authorize()['Cache-Control'])
+
+    def test_foreign_org_or_same_org_other_consumer_cannot_query_binding(self):
+        self.assertFalse(self.authorize(caller=self.foreign_raw).json()['active'])
+        package = MarketplacePackage.objects.create(slug='other-consumer', name='Other consumer', kind='application',
+            description='Separate synthetic consumer', manifest={'image': 'registry.example.test/other@sha256:' + 'b' * 64, 'capabilities': []})
+        consumer = install_package(self.org, package, [])
+        _, raw = issue_workload_credential(consumer, 'Other own-organization consumer')
+        self.assertFalse(self.authorize(caller=raw).json()['active'])
+        self.assertEqual(self.authorize(caller=self.agent_raw).status_code, 403)
+
+    def test_current_agent_binding_definition_and_role_revocation_are_enforced(self):
+        self.binding.active = False
+        self.binding.save()
+        self.assertFalse(self.authorize().json()['active'])
+        self.binding.active = True
+        self.binding.save()
+        self.agent.account.active = False
+        self.agent.account.save()
+        self.assertFalse(self.authorize().json()['active'])
+        self.agent.account.active = True
+        self.agent.account.save()
+        AgentDefinition.objects.filter(pk=self.agent.pk).update(active=False)
+        self.assertFalse(self.authorize().json()['active'])
+        AgentDefinition.objects.filter(pk=self.agent.pk).update(active=True)
+        self.binding.roles.clear()
+        self.assertFalse(self.authorize().json()['active'])
+
+    def test_environment_task_expiry_and_permission_resource_context_are_exact(self):
+        self.assertFalse(self.authorize(environment='production').json()['active'])
+        self.assertFalse(self.authorize(task_id=str(self.task.pk)).json()['active'])
+        self.assertFalse(self.authorize(permission='ungranted').json()['active'])
+        self.assertFalse(self.authorize(resource_id='another-school').json()['active'])
+        self.assertFalse(self.authorize(resource_type='another-kind').json()['active'])
+        self.assertTrue(self.authorize(binding_id=str(self.uat_binding.pk), environment='uat', task_id=str(self.task.pk)).json()['active'])
+        AgentTask.objects.filter(pk=self.task.pk).update(resources={})
+        self.assertFalse(self.authorize(binding_id=str(self.uat_binding.pk), environment='uat', task_id=str(self.task.pk)).json()['active'])
+        AgentTask.objects.filter(pk=self.task.pk).update(expires_at=timezone.now() - timedelta(seconds=1))
+        self.assertFalse(self.authorize(binding_id=str(self.uat_binding.pk), environment='uat', task_id=str(self.task.pk)).json()['active'])
+
+    def test_actual_agent_resource_tags_and_human_only_administration_apply(self):
+        tag = PermissionTag.objects.create(organization=self.org, slug='restricted-school', name='Restricted school', allow_workloads=True)
+        self.resource.permission_tags.add(tag)
+        self.assertFalse(self.authorize().json()['active'])
+        self.binding.access_tags.add(tag)
+        self.assertTrue(self.authorize().json()['active'])
+        reserved = ServicePermission.objects.create(service=self.installation.service, codename='admin', name='Reserved admin')
+        self.role.permissions.add(reserved)
+        self.assertNotIn('admin', self.authorize().json()['permissions'])
+        self.assertEqual(self.authorize(permission='admin').status_code, 400)
+        tag.requires_mfa = True
+        tag.save()
+        self.assertFalse(self.authorize().json()['active'])
+
+    def test_malformed_or_extra_context_is_rejected_without_exchange(self):
+        count = AgentCredential.objects.count()
+        self.assertEqual(self.authorize(binding_id='bad').status_code, 400)
+        self.assertEqual(self.authorize(task_id=True).status_code, 400)
+        self.assertEqual(self.authorize(permission=True).status_code, 400)
+        self.assertEqual(self.authorize(token='not-a-teacher-token').status_code, 400)
+        self.assertEqual(self.api('/agent-bindings/authorize/', method='GET').status_code, 405)
+        self.assertEqual(AgentCredential.objects.count(), count)
