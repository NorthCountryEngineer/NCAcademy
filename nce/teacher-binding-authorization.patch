+from .agent_identity import authorization, binding_valid, issue_credential, principal_for
 from .models import AgentBinding
+
+
+@workload_api(methods=('POST',))
+def authorize_binding(request):
+    """Read current authority of this consumer's own approved agent, without a token."""
+    if not request.credential:
+        raise PermissionDenied('Only a registered consuming service can authorize its own agent bindings.')
+    values = body(request)
+    required = {'binding_id', 'environment', 'task_id', 'permission', 'resource_type', 'resource_id'}
+    if set(values) != required:
+        raise ValidationError('Use an exact binding, environment, task, permission and resource context.')
+    from uuid import UUID
+    try:
+        if not isinstance(values['binding_id'], str) or str(UUID(values['binding_id'])) != values['binding_id']:
+            raise ValueError()
+        if values['task_id'] is not None and (not isinstance(values['task_id'], str) or str(UUID(values['task_id'])) != values['task_id']):
+            raise ValueError()
+    except (ValueError, TypeError, AttributeError):
+        raise ValidationError('Use canonical binding and task identifiers.')
+    if (not isinstance(values['environment'], str) or values['environment'] not in {'sandbox', 'development', 'staging', 'uat', 'production'}
+            or any(not isinstance(values[key], str) or not 1 <= len(values[key]) <= 200 for key in ('permission', 'resource_type', 'resource_id'))
+            or values['permission'] == 'admin'):
+        raise ValidationError('Use a bounded nonadministrative service permission and resource.')
+    service = request.credential.installation.service
+    binding = AgentBinding.objects.select_related('account__organization', 'installation__service', 'task').filter(
+        pk=values['binding_id'], account__organization=request.organization,
+        installation=request.credential.installation).first()
+    if not binding or not binding_valid(binding):
+        record_decision(request.access_principal, service, 'agent.binding_authorized', False, 'binding_unavailable', effective_tags(service))
+        return response({'active': False})
+    task_id = str(binding.task_id) if binding.task_id else None
+    if (values['environment'] != binding.environment or values['task_id'] != task_id
+            or request.credential.environment_id and binding.environment != request.credential.environment.name):
+        record_decision(request.access_principal, service, 'agent.binding_authorized', False, 'task_context_mismatch', effective_tags(service))
+        return response({'active': False})
+    require_access(request.access_principal, binding, 'agent.binding_authorization_read')
+    from identity.access import Principal
+    principal = Principal(agent_binding=binding, purpose=request.access_principal.purpose,
+        request_id=request.access_principal.request_id)
+    if not decision(principal, request.credential.installation)[0]:
+        record_decision(principal, service, 'agent.binding_authorized', False, 'target_service_policy', effective_tags(service))
+        return response({'active': False})
+    require_access(principal, request.credential.installation, 'agent.target_service')
+    grants = authorization(principal, service)
+    from identity.models import ProtectedResource
+    resource = ProtectedResource.objects.filter(service=service, active=True,
+        resource_type=values['resource_type'], external_id=values['resource_id']).first()
+    active = bool(values['permission'] in grants['permissions'] and resource and decision(principal, resource)[0])
+    if resource:
+        record_decision(principal, resource, 'agent.resource_authorization', active,
+            'policy_satisfied' if active else 'resource_denied', effective_tags(resource))
+    record_decision(principal, service, 'agent.binding_authorized', active,
+        'live_service_roles' if active else 'agent_role_or_resource_required', effective_tags(service))
+    if not active:
+        return response({'active': False})
+    from datetime import timedelta
+    from django.conf import settings
+    from django.utils import timezone
+    checked = timezone.now()
+    expires = min(checked + timedelta(seconds=60), binding.task.expires_at) if binding.task_id else checked + timedelta(seconds=60)
+    return response({'active': True, 'iss': settings.ISSUER, 'sub': f'urn:core:agent:{binding.account_id}',
+        'principal_kind': 'agent', 'agent_id': str(binding.account_id), 'organization_id': str(request.organization.pk),
+        'aud': service.audience, 'consumer_service_id': str(binding.installation.service_id),
+        'binding_id': str(binding.pk), 'environment': binding.environment, 'task_id': task_id,
+        'permission': values['permission'], 'resource_type': values['resource_type'], 'resource_id': values['resource_id'],
+        'iat': int(checked.timestamp()), 'exp': int(expires.timestamp()), **grants})
 
 
